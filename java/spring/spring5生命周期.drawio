        <mxCell id="1-94Or2koY-Q_ig5p6ye-67" edge="1" parent="1" source="1-94Or2koY-Q_ig5p6ye-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="1-94Or2koY-Q_ig5p6ye-57">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-94Or2koY-Q_ig5p6ye-56" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: &amp;quot;Helvetica Neue&amp;quot;; text-align: start;&quot;&gt;调用初始化方法 @PostConstruct init-method（xml）&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="420" x="1840" y="580" as="geometry" />
        </mxCell>
        <mxCell id="AhwZOfQkvX7j4SVebzLh-3" edge="1" parent="1" source="1-94Or2koY-Q_ig5p6ye-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="AhwZOfQkvX7j4SVebzLh-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-94Or2koY-Q_ig5p6ye-57" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: &amp;quot;Helvetica Neue&amp;quot;; text-align: start;&quot;&gt;执行BeanPostProcessor后置方法&lt;/p&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: &amp;quot;Helvetica Neue&amp;quot;; text-align: start;&quot;&gt;AOP涉及 在没有循环依赖的情况下&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="420" x="1840" y="690" as="geometry" />
        </mxCell>
        <mxCell id="1-94Or2koY-Q_ig5p6ye-58" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;1. doCreateBean(&quot;userService&quot;)&lt;/div&gt;&lt;div&gt;2. createBeanInstance()&amp;nbsp; →&amp;nbsp; userService 对象创建完成&lt;/div&gt;&lt;div&gt;3. earlySingletonExposure 条件成立&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ 执行 addSingletonFactory(...)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ ★ 把 userService 的 ObjectFactory 放入了三级缓存（做了准备）&lt;/div&gt;&lt;div&gt;4. populateBean()&amp;nbsp; → 注入依赖，但过程中没有任何 Bean 需要 userService&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ ★ 三级缓存中的 ObjectFactory 从头到尾没有被调用过&lt;/div&gt;&lt;div&gt;5. initializeBean()&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ postProcessAfterInitialization 创建 AOP 代理（时机③）&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="440" x="100" y="740" as="geometry" />
        </mxCell>
        <mxCell id="1-94Or2koY-Q_ig5p6ye-59" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#B20000;fillColor=#e51400;align=center;verticalAlign=middle;rounded=0;fontColor=#ffffff;" value="没有循环依赖的过程" vertex="1">
          <mxGeometry height="20" width="160" x="240" y="770" as="geometry" />
        </mxCell>
        <mxCell id="1-94Or2koY-Q_ig5p6ye-61" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;1. doCreateBean(&quot;A&quot;)&lt;/div&gt;&lt;div&gt;2. createBeanInstance() → A 对象创建完成&lt;/div&gt;&lt;div&gt;3. earlySingletonExposure 条件成立&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ ★ 把 A 的 ObjectFactory 放入了三级缓存（做了准备）&lt;/div&gt;&lt;div&gt;4. populateBean(&quot;A&quot;) → 发现需要 B，开始创建 B&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ doCreateBean(&quot;B&quot;)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ createBeanInstance() B 创建完成&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ ★ B 也做了准备，把 B 的 ObjectFactory 放入三级缓存&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ populateBean(&quot;B&quot;) → 发现需要 A&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ ★ 从三级缓存中取出 A 的 ObjectFactory，调用 getObject()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ ★ getEarlyBeanReference 被调用，A 的代理被创建（时机②）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ ★ 循环依赖被解决&lt;/div&gt;&lt;div&gt;5. B 创建完成，A 继续完成初始化&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ initializeBean(&quot;A&quot;)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ postProcessAfterInitialization 检查 earlyProxyReferences&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;→ ★ 发现 A 已经在时机②被代理了，跳过代理创建&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="490" x="620" y="710" as="geometry" />
        </mxCell>
        <mxCell id="1-94Or2koY-Q_ig5p6ye-62" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#B20000;fillColor=#e51400;align=center;verticalAlign=middle;rounded=0;fontColor=#ffffff;" value="有循环依赖的过程" vertex="1">
          <mxGeometry height="30" width="170" x="771" y="730" as="geometry" />
        </mxCell>
        <mxCell id="1-94Or2koY-Q_ig5p6ye-69" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#B20000;fillColor=#e51400;align=center;verticalAlign=middle;rounded=0;fontColor=#ffffff;" value="initializeBean&lt;div&gt;初始化bean&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="170" x="1983" y="250" as="geometry" />
        </mxCell>
        <mxCell id="AhwZOfQkvX7j4SVebzLh-4" edge="1" parent="1" source="AhwZOfQkvX7j4SVebzLh-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="AhwZOfQkvX7j4SVebzLh-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AhwZOfQkvX7j4SVebzLh-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: &amp;quot;Helvetica Neue&amp;quot;; text-align: start;&quot;&gt;注册带销毁方法的Bean&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="420" x="2440" y="325" as="geometry" />
        </mxCell>
        <mxCell id="AhwZOfQkvX7j4SVebzLh-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: &amp;quot;Helvetica Neue&amp;quot;; text-align: start;&quot;&gt;是否是FactoryBean工厂 调用工厂方法&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="420" x="2440" y="450" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
