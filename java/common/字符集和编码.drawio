        <mxCell id="SkDJjUSdfz5cXMKdHapv-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=#FF3333;align=center;verticalAlign=middle;rounded=0;" value="过程" vertex="1">
