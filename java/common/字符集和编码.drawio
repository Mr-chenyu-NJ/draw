        <mxCell id="SkDJjUSdfz5cXMKdHapv-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=#FF3333;align=center;verticalAlign=middle;rounded=0;" value="详细说明" vertex="1">
